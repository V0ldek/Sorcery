<MudPaper Elevation="2" Class="mt-6 sorcery-prev-button-container">
    <MudButton StartIcon="@Icons.Material.Filled.KeyboardDoubleArrowLeft" Size="Size.Medium" Variant="Variant.Text" Href="@Link" Class="pa-4">
        <MudText Class="sorcery-button-text" Typo="Typo.button">@ChildContent</MudText>
    </MudButton>
</MudPaper>

@code {
    [Parameter]
    [EditorRequired]
    public string Link { get; set; } = null!;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
