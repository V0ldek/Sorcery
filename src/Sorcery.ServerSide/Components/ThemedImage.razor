<div class="sorcery-hidden-on-light">
    <MudImage
        Alt="@Alt"
        title="@Title"
        Src="@DarkSrc"
        Fluid="@Fluid"
        Width="@Width"
        Height="@Height"
        ObjectPosition="@ObjectPosition"
        Elevation="@Elevation"
        ObjectFit="@ObjectFit"
        @attributes="@Attributes" />
</div>
<div class="sorcery-hidden-on-dark" hidden>
    <MudImage
        Alt="@Alt"
        title="@Title"
        Src="@LightSrc"
        Fluid="@Fluid"
        Width="@Width"
        Height="@Height"
        ObjectPosition="@ObjectPosition"
        Elevation="@Elevation"
        ObjectFit="@ObjectFit"
        @attributes="@Attributes"/>
</div>

@code {
    [Parameter]
    [EditorRequired]
    public string Alt { get; set; } = "";

    [Parameter]
    [EditorRequired]
    public string Title { get; set; } = "";

    [Parameter]
    [EditorRequired]
    public string Src { get; set; } = "";

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object> Attributes { get; set; } = new();

    [Parameter]
    public bool Fluid { get; set; }

    [Parameter]
    public int? Width { get; set; }

    [Parameter]
    public int? Height { get; set; }

    [Parameter]
    public ObjectPosition ObjectPosition { get; set; } = ObjectPosition.Center;

    [Parameter]
    public int Elevation { get; set; }

    [Parameter]
    public ObjectFit ObjectFit { get; set; } = ObjectFit.Fill;

    private string DarkSrc => Src;

    private string LightSrc
    {
        get
        {
            var withoutExtension = Path.ChangeExtension(Src, null);
            var extension = Path.GetExtension(Src);
            return $"{withoutExtension}-light{extension}";
        }
    }
}
