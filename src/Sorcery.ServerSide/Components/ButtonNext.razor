 <MudGrid Justify="Justify.FlexEnd">
    <MudItem Class="sorcery-button-next">
        <MudPaper Elevation="5">
            <MudButton StartIcon="@Icons.Material.Filled.DoubleArrow" Size="Size.Large" Variant="Variant.Text" Href="@Link" Class="pa-4">
                <MudText Class="sorcery-button-text" Typo="Typo.button">@ChildContent</MudText>
            </MudButton>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    [Parameter]
    [EditorRequired]
    public string Link { get; set; } = null!;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
