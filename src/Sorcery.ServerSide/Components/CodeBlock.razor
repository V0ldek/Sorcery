<pre data-start="@LineNumbersStartAt" class="@_preClass dark sorcery-code-block sorcery-hidden-on-light" @attributes="@_preAttributes">
    <code class="@_codeClass dark sorcery-hidden-on-light">
        @_displayCode
    </code>
</pre>
<pre data-start="@LineNumbersStartAt" class="@_preClass light sorcery-code-block sorcery-hidden-on-dark" @attributes="@_preAttributes" hidden>
    <code class="@_codeClass light sorcery-hidden-on-dark" hidden>
        @_displayCode
    </code>
</pre>

@code {
    /// <summary>
    ///     Language to use for Prism formatting. Defaults to <code>csharp</code>.
    /// </summary>
    [Parameter]
    public string? Language { get; set; } = "csharp";
    
    /// <summary>
    ///     Optional override for the language name shown in top-right of the block.
    /// </summary>
    [Parameter]
    public string? LanguageString { get; set; }

    /// <summary>
    ///     Whether to display line numbers. Defaults to false.
    /// </summary>
    [Parameter]
    public bool LineNumbers { get; set; }

    /// <summary>
    ///     Starting point for line numbering. Has no effect if
    ///     <see cref="LineNumbers"/> is false.
    /// </summary>
    [Parameter]
    public int LineNumbersStartAt { get; set; } = 1;

    /// <summary>
    ///     Source file name to display. If not given then it's omitted from the overlay.
    /// </summary>
    [Parameter]
    public string? FileName { get; set; }

    [Parameter]
    [EditorRequired]
    public string Code { get; set; } = null!;

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object> Attributes { get; set; } = new();

    private readonly Dictionary<string, object> _preAttributes = new();

    private string _codeClass = "";
    
    private string _preClass = "";

    private string _displayCode = null!;

    protected override void OnParametersSet()
    {
        _codeClass = $"language-{Language}";
        _displayCode = Code?.Trim()!;
        _preClass = $"language-{Language}";

        foreach (var kvp in Attributes)
        {
            _preAttributes.Add(kvp.Key, kvp.Value);
        }

        if (FileName is not null)
        {
            _preAttributes["data-label"] = FileName;
        }

        if (LanguageString is not null)
        {
            _preAttributes["data-language"] = LanguageString;
        }

        if (LineNumbers)
        {
            _preClass += " line-numbers";
        }
    }
}
