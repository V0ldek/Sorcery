<span id="@Id" class="sorcery-footnote" tabindex="0">
    <sup><Intralink Id="@TargetId"><MudText Typo="Typo.caption">[@Number]</MudText></Intralink></sup>
</span>

@code {
    public string Id { get; set; } = Guid.NewGuid().ToString();

    public string TargetId { get; set; } = null!;

    public int Number { get; set; }

    private FootnoteContainer? _footnoteContainer;

    [CascadingParameter]
    protected FootnoteContainer? FootnoteContainer
    {
        get => _footnoteContainer;
        set
        {
            if (!ReferenceEquals(_footnoteContainer, value))
            {
                _footnoteContainer = value;
                _footnoteContainer?.AddFootnote(this);
            }
        }
    }

    [Parameter]
    [EditorRequired]
    public RenderFragment ChildContent { get; set; } = null!;
}
