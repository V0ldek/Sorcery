@inherits LayoutComponentBase

<MudDialogProvider />
<MudSnackbarProvider />
<MudLayout id="mud-layout">
    <MudAppBar Elevation="1">
        <MudIconButton id="drawer-toggle-button" Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" aria-label="Menu" />
        <a class="d-flex" href="/">
            <MudAvatar Variant="Variant.Filled">
                <MudImage Src="/img/v0ldek.webp" Title="Gravatar" Alt="my gravatar" Class="mud-avatar-img" ObjectFit="ObjectFit.Cover"/>
            </MudAvatar>
            <MudText Typo="Typo.h5" Class="ml-3 mt-auto mb-auto">Mat Gienieczko</MudText>
        </a>
        <MudSpacer/>
        <span class="d-flex flex-row justify-center align-center">
            <MudIconButton id="enable-dark-mode-button" Icon="@Icons.Material.Filled.DarkMode" Color="Color.Inherit"
                           Class="sorcery-hidden-on-dark"
                           aria-label="Dark mode toggle" hidden></MudIconButton>
            <MudIconButton id="enable-light-mode-button" Icon="@Icons.Material.Filled.LightMode" Color="Color.Inherit"
                           Class="sorcery-hidden-on-light"
                           aria-label="Light mode toggle"></MudIconButton>
            <span class="d-none d-sm-flex flex-row justify-center align-center">
                <MudIconButton Icon="@Icons.Material.Filled.RssFeed" Color="Color.Inherit" Href="/feed.rss" aria-label="RSS feed"></MudIconButton>
                <MudIconButton Icon="@Icons.Custom.Brands.GitHub" Color="Color.Inherit" Href="@GitHub.Sorcery" aria-label="GitHub"></MudIconButton>
                <MudIconButton Icon="fa-brands fa-bluesky" Color="Color.Inherit" Href="https://bsky.app/profile/gienieczko.com" aria-label="BlueSky"></MudIconButton>
                <MudText Typo="Typo.caption" Class="ps-4"><footer><small>Copyright &copy; @Copyright Mateusz Gienieczko</small></footer></MudText>
            </span>
        </span>
    </MudAppBar>
    <MudDrawer id="nav-drawer" Open="true" ClipMode="DrawerClipMode.Always" Elevation="2">
        <NavMenu />
    </MudDrawer>
    <MudMainContent Class="pt-16 pa-4">
        @Body
        <MudScrollToTop>
            <MudFab Color="Color.Dark" StartIcon="@Icons.Material.Filled.ArrowUpward" />
        </MudScrollToTop>
    </MudMainContent>
</MudLayout>


@code {
    private static string Copyright
    {
        get
        {
            const int startYear = 2022;
            var year = DateTime.Now.Year;
            return year == startYear ? startYear.ToString() : $"{startYear} - {year}";
        }
    }
}


