@using System.Web;
@using Sorcery.Blogging;

<MudCard Class="mud-button blog-post-card" Elevation="5" @attributes="@Attributes">
    <a class="blog-post-card-link" href="@Post.Route"></a>
    <MudCardHeader>
        <CardHeaderContent>
            <div class="d-flex gap-4">
                <div class="d-flex flex-grow-1" style="width: 55%">
                    <MudLink Href="@Post.Route">
                        <MudText Typo="Typo.h6" Color="Color.Primary">@HttpUtility.HtmlDecode(Post.Title)</MudText>
                    </MudLink>
                </div>
                <div style="width: 45%">
                    <div class="d-flex flex-grow-1" style="text-align: right">
                        <MudText Typo="Typo.caption" Style="width: 100%">Published: @Post.DateOfPublication?.ToString("yyyy-MM-dd")</MudText>
                    </div>
                    <div class="d-flex" style="text-align: right">
                        <MudText Typo="Typo.caption" Style="width: 100%">Tags: <BlogPostTags Tags="@Post.Tags"/></MudText>
                    </div>
                </div>
            </div>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        @Post.Description
    </MudCardContent>
</MudCard>

@code {
    [Parameter]
    [EditorRequired]
    public Post Post { get; set; } = null!;

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object> Attributes { get; set; } = new();
}
