@using System.Web;
@using Sorcery.Blogging;

<MudCard Class="mud-button sorcery-blog-post-card" Elevation="5" @attributes="@Attributes">
    <a class="full-card-link" href="@Post.Route"></a>
    <MudCardHeader>
        <CardHeaderContent>
            <div class="d-none d-sm-flex gap-4">
                <div class="d-flex flex-grow-1 header-title">
                    <MudLink Href="@Post.Route">
                        <MudText Typo="Typo.h6" Color="Color.Primary">@HttpUtility.HtmlDecode(Post.Title)</MudText>
                    </MudLink>
                </div>
                <div class="header-metadata">
                    <div class="d-flex flex-grow-1">
                        <MudText Typo="Typo.caption">Published: @Post.DateOfPublication?.ToString("yyyy-MM-dd")</MudText>
                    </div>
                    <div class="d-flex">
                        <MudText Typo="Typo.caption" Class="tags">Tags: <BlogPostTags Tags="@Post.Tags"/></MudText>
                    </div>
                </div>
            </div>
            <div class="d-block d-sm-none gap-4">
                <div class="my-2">
                    <div class="d-flex flex-grow-1">
                        <MudText Typo="Typo.caption">Published: @Post.DateOfPublication?.ToString("yyyy-MM-dd")</MudText>
                    </div>
                    <div class="d-flex">
                        <MudText Typo="Typo.caption" Class="tags">Tags: <BlogPostTags Tags="@Post.Tags"/></MudText>
                    </div>
                </div>
                <div class="d-flex flex-grow-1">
                    <MudLink Href="@Post.Route">
                        <MudText Typo="Typo.h6" Color="Color.Primary">@HttpUtility.HtmlDecode(Post.Title)</MudText>
                    </MudLink>
                </div>
            </div>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        @Post.Description
    </MudCardContent>
</MudCard>

@code {
    [Parameter]
    [EditorRequired]
    public Post Post { get; set; } = null!;

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object> Attributes { get; set; } = new();
}
