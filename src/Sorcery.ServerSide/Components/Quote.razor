<MudPaper Elevation="0" Class="my-4 pa-2 d-block sorcery-quote-container " Width="100%">
    <blockquote>
        <MudIcon Icon="@Icons.Material.Filled.FormatQuote"></MudIcon> 
        <MudText Inline="true" Class="pl-2">
            <i class="quote-text sorcery-hidden-on-light">@ChildContent</i><i class="quote-text-light sorcery-hidden-on-dark" hidden="">@ChildContent</i>
        </MudText>
    </blockquote>
</MudPaper>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
