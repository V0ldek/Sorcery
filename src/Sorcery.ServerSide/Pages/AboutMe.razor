@page "/about"

<PageTitle>About Mat Gienieczko</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large">
    <MudPaper Height="100%" Width="100%" Class="pa-sm-16 pa-4 my-4">
        <MudGrid Justify="Justify.SpaceBetween">
            <MudItem xs="6">
                 <MudText Typo="Typo.h1">About Me</MudText>
            </MudItem>
            <MudItem xs="6" sm="3" Class="ma-auto">
                <MudAvatarGroup MaxSize="Size.Large" Outlined="true" OutlineColor="Color.Primary">
                    <MudSpacer />
                    <MudAvatar Size="Size.Large">
                        <MudImage Alt="my gravatar" Src="/img/v0ldek.webp" ObjectFit="ObjectFit.Cover"></MudImage>
                    </MudAvatar>
                    <MudAvatar Size="Size.Large" Variant="Variant.Filled">
                        <MudImage Alt="my actual photo" Src="/img/me.webp" ObjectFit="ObjectFit.Cover"></MudImage>
                    </MudAvatar>
                </MudAvatarGroup>
            </MudItem>
        </MudGrid>
        <MudDivider Class="my-6" DividerType="DividerType.FullWidth" Vertical="false"/>

        <article id="about-me-article">
            <Paragraph>I'm Mateusz Gienieczko, on most sites and apps under the nickname of V0ldek.</Paragraph>

            <Paragraph>
                I'm a programmer and a computer scientist, by education, choice, and heart.
                I'm currently pursuing a PhD in Computer Science at the Technical University of Munich.
                Graduated with a Master's in Computer Science at the University of Warsaw.
                I like making stuff <em><span class="fas fa-bolt"></span>fast<span class="fas fa-bolt"></span></em>
                with focus on databases, compilation, modern hardware,
                and personal affinity for automata and theory of computation.
            </Paragraph>

            <Paragraph>
                I'm the author of <LinkA Href="https://github.com/rsonquery/rsonpath">rsonpath</LinkA> and
                <LinkA Href="https://github.com/AnyBlox">AnyBlox</LinkA>.
                You can find my published research under <LinkA Href="/research">Research</LinkA> or at ORCID:
                <LinkA
                    Href="https://orcid.org/0000-0002-6410-8884"
                    id="cy-effective-orcid-url"
                    class="underline orcid-id"
                    target="orcid.widget"
                    rel="me noopener noreferrer">
                    <img
                        src="https://orcid.org/sites/default/files/images/orcid_16x16.png"
                        class="orcid-id-icon"
                        alt="ORCID iD icon"/>
                    Mateusz Gienieczko (ORCID)
                </LinkA>
            </Paragraph>

            <Paragraph>
                You can contact me at <Code>String.Format("{0}@@{1}.com", "mat", "gienieczko")</Code>.
            </Paragraph>


            <Paragraph>Here's a gist in the form of a little timeline:</Paragraph>
        </article>

        <MudTimeline TimelineAlign="TimelineAlign.Start">
            <MudTimelineItem>
                <ItemOpposite>
                    <MudText Color="Color.Primary" Typo="Typo.h6">2013</MudText>
                </ItemOpposite>
                <ItemContent>
                    <MudPaper Elevation="0" Class="mt-n1">
                        <MudText Color="Color.Primary" Typo="Typo.h6" GutterBottom="true">Hello, World!</MudText>
                        <MudText Typo="Typo.caption">
                            Mat writes his first line of code. This has made a lot of people very angry and been widely regarded as a bad move.
                        </MudText>
                    </MudPaper>
                </ItemContent>
            </MudTimelineItem>
            <MudTimelineItem>
                <ItemOpposite>
                    <MudText Color="Color.Primary" Typo="Typo.h6">2020</MudText>
                </ItemOpposite>
                <ItemContent>
                    <MudPaper Elevation="0" Class="mt-n1">
                        <MudText Color="Color.Primary" Typo="Typo.h6" GutterBottom="true">Bachelor's in Computer Science</MudText>
                        <MudText Typo="Typo.caption">
                            Thesis: Product Scanner &ndash; 
                            an image reconstruction app for generating fully textured 3D models of products
                            with an Azure Kinect camera. Unfortunately proprietary, IP went to <LinkA Href="https://aifi.com/" Typo="@Typo.caption">AiFi</LinkA>.
                        </MudText>
                    </MudPaper>
                </ItemContent>
            </MudTimelineItem>
            <MudTimelineItem>
                <ItemOpposite>
                    <MudText Color="Color.Primary" Typo="Typo.h6">July 2022</MudText>
                </ItemOpposite>
                <ItemContent>
                    <MudPaper Elevation="0" Class="mt-n1">
                        <MudText Color="Color.Primary" Typo="Typo.h6" GutterBottom="true">Master's in Computer Science</MudText>
                        <MudText Typo="Typo.caption">
                            Thesis: rapid execution of queries on JSON documents with SIMD.
                            Available <LinkA Href="/masters">here</LinkA>.
                        </MudText>
                    </MudPaper>
                </ItemContent>
            </MudTimelineItem>
            <MudTimelineItem>
                <ItemOpposite>
                   <MudText Color="Color.Primary" Typo="Typo.h6">August 2022</MudText>
                </ItemOpposite>
                <ItemContent>
                    <MudPaper Elevation="0" Class="mt-n1">
                        <MudText Color="Color.Primary" Typo="Typo.h6" GutterBottom="true">Microsoft</MudText>
                        <MudText Typo="Typo.caption">
                        Mat migrates to Dublin, Ireland to work at Microsoft.
                        </MudText>
                    </MudPaper>
                </ItemContent>
            </MudTimelineItem>
            <MudTimelineItem>
                <ItemOpposite>
                   <MudText Color="Color.Primary" Typo="Typo.h6">November 2023</MudText>
                </ItemOpposite>
                <ItemContent>
                    <MudPaper Elevation="0" Class="mt-n1">
                        <MudText Color="Color.Primary" Typo="Typo.h6" GutterBottom="true">PhD at TUM</MudText>
                        <MudText Typo="Typo.caption">
                            Mat ditches the corpo life to pursue a PhD at the Technische Universität München
                        </MudText>
                    </MudPaper>
                </ItemContent>
            </MudTimelineItem>
            <MudTimelineItem Color="Color.Transparent" Variant="Variant.Filled" Elevation="0" Size="Size.Large">
                <ItemDot>
                    <MudIcon Icon="@Icons.Material.Filled.MoreVert" Color="Color.Default" Size="Size.Large"></MudIcon>
                </ItemDot>
            </MudTimelineItem>
            <MudTimelineItem HideDot="true">
                <ItemDot></ItemDot>
            </MudTimelineItem>
            <MudTimelineItem>
                <ItemOpposite>
                    <MudText Color="Color.Primary" Typo="Typo.h6">@(DateTime.Now.Year + 13) (planned)</MudText>
                </ItemOpposite>
                <ItemContent>
                    <MudText Typo="Typo.caption">
                        Complete world domination.
                    </MudText>
                </ItemContent>
            </MudTimelineItem>
        </MudTimeline>
    </MudPaper>
</MudContainer>
