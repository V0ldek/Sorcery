        </ListItem>
        <ListItem Icon="@Icons.Material.Filled.ChevronRight">
            Generic extension methods.
        </ListItem>
        <ListItem Icon="@Icons.Material.Filled.ChevronRight">
            Scoping rules and namespace guidelines.
        </ListItem>
    </OList>
    <Resources Links=@(new [] {
        ("https://docs.microsoft.com/en-us/dotnet/csharp/programming-guide/classes-and-structs/extension-methods", "Extension Methods (C# Programming Guide)"),
        ("https://docs.microsoft.com/en-us/dotnet/standard/design-guidelines/extension-methods", "Extension Methods (Design Guidelines)"),
        ("https://docs.microsoft.com/en-us/dotnet/csharp/language-reference/keywords/using-directive#static-modifier", "Static using directive"),
        ("https://www.martinfowler.com/bliki/FluentInterface.html", "FluentInterface (Martin Fowler)"),
    })/>
</CourseSection>

