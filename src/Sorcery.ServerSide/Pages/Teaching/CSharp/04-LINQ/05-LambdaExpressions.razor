        </ListItem>
    </OList>
    <Resources Links=@(new [] {
        ("https://docs.microsoft.com/en-us/dotnet/csharp/language-reference/operators/lambda-expressions", "Lambda Expressions (C# reference)"),
    })/>
</CourseSection>

