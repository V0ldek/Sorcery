        </ListItem>
        <ListItem Icon="@Icons.Material.Filled.ChevronRight">
            Captures.
        </ListItem>
        <ListItem Icon="@Icons.Material.Filled.ChevronRight">
            Lambda implementation details.
        </ListItem>
        <ListItem Icon="@Icons.Material.Filled.ChevronRight">
