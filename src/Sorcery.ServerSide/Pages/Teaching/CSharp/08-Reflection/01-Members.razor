@page "/teaching/csharp/8-reflection/1-members"
@inject CourseBook CourseBook;

@{
    var course = CourseBook.CSharpCourse["reflection"]["members"];
}

<CourseSection Section="@course">
    <MudText GutterBottom="true">
        Next one in <LinkA Href="@GitHub.CSharpNotebooks" Target="_blank">the notebooks repository</LinkA>:
        <Highlight>@($"{course.Module.Id}-{course.Module.RouteName}/{course.Id}-{course.RouteName}.dib")</Highlight>.
    </MudText>
    <Header2>In this section we'll cover</Header2>
     <OList>
        <ListItem Icon="@Icons.Material.Filled.ChevronRight">
            <Code>BindingFlags</Code>.
        </ListItem>
        <ListItem Icon="@Icons.Material.Filled.ChevronRight">
            <Code>MemberInfo</Code>.
        </ListItem>
        <ListItem Icon="@Icons.Material.Filled.ChevronRight">
            Invoking methods via <Code>MethodInfo</Code>.
        </ListItem>
        <ListItem Icon="@Icons.Material.Filled.ChevronRight">
            Invoking methods via a constructed delegate.
        </ListItem>
        <ListItem Icon="@Icons.Material.Filled.ChevronRight">
            Accessing properties.
        </ListItem>
        <ListItem Icon="@Icons.Material.Filled.ChevronRight">
            Accessing fields.
        </ListItem>
    </OList>
    <Resources Links=@(new [] {
        ("https://dejanstojanovic.net/aspnet/2019/february/making-reflection-in-net-work-faster/", "Making Reflection in .NET work faster"),
    })/>
</CourseSection>

