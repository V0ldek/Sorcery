            Ambient/transient transactions with <Code>System.Transactions</Code>.
        </ListItem>
    </OList>
    <Resources Links=@(new [] {
        ("https://docs.microsoft.com/en-us/ef/core/saving/transactions", "Transactions (EF Docs)"),
     })/>
</CourseSection>

