        <ListItem Icon="@Icons.Material.Filled.ChevronRight"><Code>switch</Code></ListItem>
        <ListItem Icon="@Icons.Material.Filled.ChevronRight">default values;</ListItem>
        <ListItem Icon="@Icons.Material.Filled.ChevronRight">operator overloading;</ListItem>
        <ListItem Icon="@Icons.Material.Filled.ChevronRight">exceptions for defensive programming;</ListItem>
        <ListItem Icon="@Icons.Material.Filled.ChevronRight">nullability, Nullable Reference Types;</ListItem>
        <ListItem Icon="@Icons.Material.Filled.ChevronRight">casting, <Code>is</Code>, <Code>as</Code>;</ListItem>
        <ListItem Icon="@Icons.Material.Filled.ChevronRight">passing by reference.</ListItem>
    </OList>
</CourseModuleIntroduction>

