@page "/teaching/csharp/0-basics/4-control-flow"
@inject CourseBook CourseBook;

@{
    var course = CourseBook.CSharpCourse["basics"]["control-flow"];
}

<CourseSection Section="@CourseBook.CSharpCourse["basics"]["control-flow"]">
    <Paragraph>
        Continuing with <LinkA Href="@GitHub.CSharpNotebooks" Target="_blank">the notebooks repository</LinkA>
        go through the next notebook, <Highlight>@($"{course.Module.Id}-{course.Module.RouteName}/{course.Id}-{course.RouteName}.dib")</Highlight>, in VS Code.
    </Paragraph>
    <Header2>In this section we'll cover</Header2>
        
    <OList>
        <ListItem Icon="@Icons.Material.Filled.ChevronRight">
            <MudText>
                Control flow with <Code>if</Code> and loops.
            </MudText>
        </ListItem>
        <ListItem Icon="@Icons.Material.Filled.ChevronRight">
            <MudText>
                Variable scoping rules.
            </MudText>
        </ListItem>
        <ListItem Icon="@Icons.Material.Filled.ChevronRight">
            <MudText>
                Definite assignment rules.
            </MudText>
        </ListItem>
    </OList>
</CourseSection>

