        let mut operands = Vec::with_capacity(data.args().len());
        for arg in data.args() {
            let val = self.generate_generic_expr(arg, env, block)?;
            operands.push(val);
        }

        // `transpose` has special handling and maps to toy.transpose
        if data.callee().as_ref() == ""transpose"" {
            // `transpose` is unary.
            if operands.len() > 1 {
                Err(CodegenError::invalid_transpose_arguments(operands.len(), data.loc()))
            } else {
                let op = toy::transpose(self.context, operands[0], data.loc().mlir_loc(self.context));
                let val = op.result(0)?;
                block.append_operation(op);
                Ok(val.into())
            }
        } else {
            // generate a generic call
            let op = toy::generic_call(
                self.context,
                &operands,
                data.callee().as_ref(),
                data.loc().mlir_loc(self.context),
            );
            let val = op.result(0)?;
            block.append_operation(op);
            Ok(val.into())
        }
    }
}
")></CodeBlock>
    <Paragraph>
        Finally, referencing a declared variable is delightfully simple &ndash; it actually generates no code at all!
        We just refer to a value that was defined in the block before and was saved in our environment.
    </Paragraph>
    <CodeBlock Language="rust" FileName="src/codegen.rs" Code=@(@"
impl<'c> Codegen<'c> {
    /* ... ✂️ snip ... */

    /// Generate a reference to a variable.
    ///
    /// This does not generate any new code, just refers to an existing MLIR value declared
    /// in `env`.
    fn generate_var_expr<'a>(data: &VarData, env: &Env<'c, 'a>) -> Result<ir::Value<'c, 'a>, CodegenError> {
        if let Some((var, _)) = env.lookup(data.name().as_ref()) {
            Ok(*var)
        } else {
            Err(CodegenError::undeclared_variable(data.name().as_ref(), data.loc()))
        }
    }
}
")></CodeBlock>
    <Paragraph>
        Now we just need to glue it all together. We create a new binary, <Code>toyc</Code>,
        that takes some Toy code, parses it, and then generates the MLIR code. In Melior we can print an entire
        module by using its <Code>Display</Code> impl, like Ferris intended.
    </Paragraph>
    <CodeBlock Language="rust" FileName="src/tools/toyc.rs" Code=@(@"
//! Codegen entry point that can read .toy source.
use anyhow::Result;
use clap::Parser;
use mlir_toy_rust::{codegen::MlirGenerator, parser::parse};
use std::io::Read;
use std::path::PathBuf;

/// Generate code from .toy source.
#[derive(Parser, Debug)]
struct Args {
    /// Path to the source file.
    ///
    /// If not provided reads from standard input.
    file_path: Option<String>,
}

fn main() -> Result<()> {
    let args = Args::parse();

    let (file_name, source) = if let Some(file_path) = args.file_path {
        let path = PathBuf::from(&file_path);
        let source = std::fs::read_to_string(&path)?;
        (file_path, source)
    } else {
        let mut string = String::new();
        std::io::stdin().lock().read_to_string(&mut string)?;
        (""<stdin>"".to_string(), string)
    };

    let ast = parse(&source, &file_name.into())?;

    let codegen = MlirGenerator::new();
    let mlir_module = codegen.generate_mlir(&ast)?;

    let code = mlir_module.as_operation().to_string();

    println!(""{code}"");

    Ok(())
}
")></CodeBlock>
    <Paragraph>
        We can now take the example code that defines the <Code>multiply_transpose</Code> function
        and generate code for it with <Code>cargo run --bin toyc -- ./toy/valid/ch2.toy</Code>:
    </Paragraph>
    <CodeBlock Language="python" LanguageString="Toy" FileName="toy/valid/ch2.toy" LineNumbers="true" Code=@(@"
# This file is part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
# See https://llvm.org/LICENSE.txt for license information.

# User defined generic function that operates on unknown shaped arguments.
def multiply_transpose(a, b) {
  return transpose(a) * transpose(b);
}

def main() {
  var a<2, 3> = [[1, 2, 3], [4, 5, 6]];
  var b<2, 3> = [1, 2, 3, 4, 5, 6];
  var c = multiply_transpose(a, b);
  var d = multiply_transpose(b, a);
  print(d);
}")></CodeBlock>
    <CodeBlock Language="llvm" LanguageString="MLIR" Code=@(@"
module {
  ""toy.func""() ({
  ^bb0(%arg0: tensor<*xf64>, %arg1: tensor<*xf64>):
    %0 = ""toy.transpose""(%arg0) : (tensor<*xf64>) -> tensor<*xf64>
    %1 = ""toy.transpose""(%arg1) : (tensor<*xf64>) -> tensor<*xf64>
    %2 = ""toy.mul""(%0, %1) : (tensor<*xf64>, tensor<*xf64>) -> tensor<*xf64>
    ""toy.return""(%2) : (tensor<*xf64>) -> ()
    ""toy.return""() : () -> ()
  }) {function_type = (tensor<*xf64>, tensor<*xf64>) -> (), sym_name = ""multiply_transpose""} : () -> ()
  ""toy.func""() ({
    %0 = ""toy.constant""() {value = dense<[[1.000000e+00, 2.000000e+00, 3.000000e+00], [4.000000e+00, 5.000000e+00, 6.000000e+00]]> : tensor<2x3xf64>} : () -> tensor<2x3xf64>
    %1 = ""toy.reshape""(%0) : (tensor<2x3xf64>) -> tensor<2x3xf64>
    %2 = ""toy.constant""() {value = dense<[1.000000e+00, 2.000000e+00, 3.000000e+00, 4.000000e+00, 5.000000e+00, 6.000000e+00]> : tensor<6xf64>} : () -> tensor<6xf64>
    %3 = ""toy.reshape""(%2) : (tensor<6xf64>) -> tensor<2x3xf64>
    %4 = ""toy.generic_call""(%1, %3) {callee = @multiply_transpose} : (tensor<2x3xf64>, tensor<2x3xf64>) -> tensor<*xf64>
    %5 = ""toy.generic_call""(%3, %1) {callee = @multiply_transpose} : (tensor<2x3xf64>, tensor<2x3xf64>) -> tensor<*xf64>
    ""toy.print""(%5) : (tensor<*xf64>) -> ()
    ""toy.return""() : () -> ()
  }) {function_type = () -> (), sym_name = ""main""} : () -> ()
}")></CodeBlock>
    <Paragraph>
        And there we go! The output is as we expect, even if it's hella verbose. If you look through it then the code is
        equivalent to this less verbose output:
    </Paragraph>
    <CodeBlock Language="llvm" LanguageString="MLIR" Code=@(@"
module {
  toy.func @multiply_transpose(%arg0: tensor<*xf64>, %arg1: tensor<*xf64>) -> tensor<*xf64> {
    %0 = toy.transpose(%arg0 : tensor<*xf64>) to tensor<*xf64>
    %1 = toy.transpose(%arg1 : tensor<*xf64>) to tensor<*xf64>
    %2 = toy.mul %0, %1 : tensor<*xf64>
    toy.return %2 : tensor<*xf64>
  }
  toy.func @main() {
    %0 = toy.constant dense<[[1.000000e+00, 2.000000e+00, 3.000000e+00], [4.000000e+00, 5.000000e+00, 6.000000e+00]]> : tensor<2x3xf64>
    %1 = toy.reshape(%0 : tensor<2x3xf64>) to tensor<2x3xf64>
    %2 = toy.constant dense<[1.000000e+00, 2.000000e+00, 3.000000e+00, 4.000000e+00, 5.000000e+00, 6.000000e+00]> : tensor<6xf64>
    %3 = toy.reshape(%2 : tensor<6xf64>) to tensor<2x3xf64>
    %4 = toy.generic_call @multiply_transpose(%1, %3) : (tensor<2x3xf64>, tensor<2x3xf64>) -> tensor<*xf64>
    %5 = toy.generic_call @multiply_transpose(%3, %1) : (tensor<2x3xf64>, tensor<2x3xf64>) -> tensor<*xf64>
    toy.print %5 : tensor<*xf64>
    toy.return
  }
}")></CodeBlock>
    <Paragraph GutterBottom="false">
        We will see how to make MLIR pretty-print our dialect in the next chapter.
    </Paragraph>
    <Header2>Summary</Header2>
    <Paragraph>
        We have codegen, but for the time being we're basically
        generating opaque operations &ndash; MLIR has no idea about any semantics of the dialect since we didn't
        register it with the framework. To be able to pretty-print our assembly, verify operations, and later define
        optimisation passes, we need to hook those ops into the MLIR context. This will require C++ interop and we'll
        cover it in the next chapter.
    </Paragraph>
</BlogPost>
