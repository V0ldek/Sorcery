|  |--VarDecl [ident = b, ty = <2, 3>] @./toy/valid/ch1.toy@8:3
|  |  |--Literal [ty = <6>] @./toy/valid/ch1.toy@8:17
|  |  |  |--Num [value = 1] @./toy/valid/ch1.toy@8:18
|  |  |  |--Num [value = 2] @./toy/valid/ch1.toy@8:21
|  |  |  |--Num [value = 3] @./toy/valid/ch1.toy@8:24
|  |  |  |--Num [value = 4] @./toy/valid/ch1.toy@8:27
|  |  |  |--Num [value = 5] @./toy/valid/ch1.toy@8:30
|  |  |  |--Num [value = 6] @./toy/valid/ch1.toy@8:33
|  |--VarDecl [ident = c] @./toy/valid/ch1.toy@9:3
|  |  |--Call [callee = multiply_transpose] @./toy/valid/ch1.toy@9:11
|  |  |  |--Var [ident = a] @./toy/valid/ch1.toy@9:30
|  |  |  |--Var [ident = b] @./toy/valid/ch1.toy@9:33
|  |--Print @./toy/valid/ch1.toy@10:3
|  |  |--BinOp [op = Add] @./toy/valid/ch1.toy@10:9
